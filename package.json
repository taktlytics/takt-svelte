{
  "name": "@vskstudio/takt-svelte",
  "version": "0.10.0",
  "description": "Idiomatic Svelte wrapper for Takt privacy-friendly analytics",
  "license": "MIT",
  "author": "VSK Studio",
  "type": "module",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/element/index.js",
  "jsdelivr": "./dist/element/index.js",
  "sideEffects": [
    "./dist/element/index.js"
  ],
  "keywords": [
    "analytics",
    "privacy",
    "svelte",
    "sveltekit",
    "takt"
  ],
  "homepage": "https://github.com/taktlytics/takt-svelte#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taktlytics/takt-svelte.git"
  },
  "bugs": {
    "url": "https://github.com/taktlytics/takt-svelte/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "svelte": "./dist/actions/index.js",
      "default": "./dist/actions/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "import": "./dist/element/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm build:lib && pnpm build:element",
    "build:lib": "svelte-package --input src/lib --output dist",
    "build:element": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "size": "size-limit",
    "prepublishOnly": "pnpm build",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "@vskstudio/takt-core": ">=0.12.1",
    "svelte": "^5.19.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.50.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/svelte": "^5.2.0",
    "@vskstudio/takt-core": "^0.12.1",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.19.0",
    "jsdom": "^25.0.0",
    "size-limit": "^11.1.6",
    "svelte": "^5.56.3",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.0.0"
}
